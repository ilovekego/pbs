# ==============================================================================
# MURANG'A COUNTY PUBLIC SERVICE PORTAL - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application & Security Core
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=generate_a_secure_random_key_here_min_32_characters

# Database Configuration
# Local SQLite fallback: sqlite:///database.db
# Production PostgreSQL format: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///database.db

# TalkSasa Bulk SMS v3 API Integration
TALKSASA_API_ENDPOINT=https://bulksms.talksasa.com/api/v3/sms/send
TALKSASA_API_TOKEN=your_talksasa_bearer_token_here
TALKSASA_SENDER_ID=TALK-SASA

# Resend Transactional Email API Integration
RESEND_API_KEY=re_your_resend_api_key_here
MAIL_DEFAULT_SENDER=Murang'a County Portal <otp@vinniedigitalhub.co.ke>
MAIL_RESET_SENDER=Murang'a County Portal <reset@vinniedigitalhub.co.ke>

# Mwananchi AI Agent Engine Core Endpoint
MWANANCHI_AI_ENDPOINT=https://api.vinniedigitalhub.co.ke/ai/gpt